generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DailyEntry {
  id               String   @id @default(uuid())
  date             DateTime @unique

  // Estado de ánimo (1=muy mal, 2=mal, 3=regular, 4=bien, 5=excelente)
  mood             Int
  moodNotes        String?

  // Intimidad
  hasIntimacy      Boolean  @default(false)
  intimacyQuality  Int?     // 1-5

  // Disgusto
  hasDisgust         Boolean  @default(false)
  disgustReason      String?
  disgustCategory    String?  // comunicacion | actitud | economico | domestico | celos | otro
  disgustIntensity   Int?     // 1-5
  disgustResolved    Boolean  @default(false)

  // Período
  isPeriodDay      Boolean  @default(false)
  periodDayNumber  Int?
  periodSymptoms   String?

  // Detalles / gestos
  hasDetail         Boolean  @default(false)
  detailFrom        String?  // 'me' | 'her' | 'both'
  detailType        String?  // regalo | salida | palabras | ayuda | sorpresa | otro
  detailDescription String?

  // Energía
  energyLevel      Int?     // 1-5

  // Perspectiva de ella
  herMood          Int?     // 1-5
  herMoodNotes     String?
  herEnergyLevel   Int?     // 1-5
  herNotes         String?  // notas libres de ella

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model SpecialDate {
  id           String   @id @default(uuid())
  name         String
  month        Int      // 1-12
  day          Int      // 1-31
  type         String   // birthday | anniversary | other
  notes        String?
  reminderDays Int      @default(3)
  createdAt    DateTime @default(now())
}

model PeriodCycle {
  id        String    @id @default(uuid())
  startDate DateTime
  endDate   DateTime?
  duration  Int?
  notes     String?
  createdAt DateTime  @default(now())
}
