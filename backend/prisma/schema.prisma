generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Multi-tenant: cada pareja (Couple) agrupa a sus usuarios y datos
// ─────────────────────────────────────────────────────────────

model Couple {
  id           String         @id @default(uuid())
  name         String?
  createdAt    DateTime       @default(now())

  users        User[]
  entries      DailyEntry[]
  cycles       PeriodCycle[]
  specialDates SpecialDate[]
  config       CoupleConfig[]
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("partner") // 'owner' | 'partner'
  age          Int?

  coupleId     String?
  couple       Couple?  @relation(fields: [coupleId], references: [id])

  createdAt    DateTime @default(now())
}

// Invitaciones para enlazar dos usuarios como pareja
model CoupleInvite {
  id         String   @id @default(uuid())
  fromUserId String
  toEmail    String
  status     String   @default("pending") // pending | accepted | rejected
  createdAt  DateTime @default(now())

  @@index([toEmail])
}

// Configuración por pareja (edad máx., min/encuentro, etc.)
model CoupleConfig {
  id        String   @id @default(uuid())
  coupleId  String
  couple    Couple   @relation(fields: [coupleId], references: [id])
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@unique([coupleId, key])
}

model DailyEntry {
  id               String   @id @default(uuid())
  date             DateTime

  coupleId         String?
  couple           Couple?  @relation(fields: [coupleId], references: [id])

  // Estado de ánimo (1=muy mal, 2=mal, 3=regular, 4=bien, 5=excelente)
  mood             Int
  moodNotes        String?

  // Intimidad
  hasIntimacy      Boolean  @default(false)
  intimacyQuality  Int?     // 1-5

  // Disgusto
  hasDisgust         Boolean  @default(false)
  disgustReason      String?
  disgustCategory    String?  // comunicacion | actitud | economico | domestico | celos | otro
  disgustIntensity   Int?     // 1-5
  disgustResolved    Boolean  @default(false)

  // Período
  isPeriodDay      Boolean  @default(false)
  periodDayNumber  Int?
  periodSymptoms   String?

  // Detalles / gestos
  hasDetail         Boolean  @default(false)
  detailFrom        String?  // 'me' | 'her' | 'both'
  detailType        String?  // regalo | salida | palabras | ayuda | sorpresa | otro
  detailDescription String?

  // Energía
  energyLevel      Int?     // 1-5

  // Perspectiva de ella
  herMood          Int?     // 1-5
  herMoodNotes     String?
  herEnergyLevel   Int?     // 1-5
  herNotes         String?  // notas libres de ella

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([coupleId, date])
}

model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model SpecialDate {
  id           String   @id @default(uuid())

  coupleId     String?
  couple       Couple?  @relation(fields: [coupleId], references: [id])

  name         String
  month        Int      // 1-12
  day          Int      // 1-31
  type         String   // birthday | anniversary | other
  notes        String?
  reminderDays Int      @default(3)
  createdAt    DateTime @default(now())
}

model PeriodCycle {
  id        String    @id @default(uuid())

  coupleId  String?
  couple    Couple?   @relation(fields: [coupleId], references: [id])

  startDate DateTime
  endDate   DateTime?
  duration  Int?
  notes     String?
  createdAt DateTime  @default(now())
}
